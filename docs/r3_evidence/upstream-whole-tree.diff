+
+        with runtime_observation_scope(branch="negative"):
+            [noise_pred_uncond], *_ = self.model(latent, **uncond_kwargs)
+            emit_runtime_observation(
+                "cfg-branch-output", output_tensor=noise_pred_uncond
+            )
+
+        if offload_model:
+            noise_pred_uncond = noise_pred_uncond.to('cpu')
+            torch.cuda.empty_cache()
+
+        noise_pred = noise_pred_uncond + guide_scale * (
+            noise_pred_cond - noise_pred_uncond
+        )
+
+        return noise_pred, simil_masks, generated_simil_masks
+
+    def generate_from_latents(
+        self,
+        img: Image.Image,
+        prompt_sentences: list[str],
+        bias_kwargs,
+        latent,
+        t_i=None,
+        max_area=720 * 1280,
+        frame_num=81,
+        shift=5.0,
+        sample_solver='unipc',
+        sampling_steps=40,
+        guide_scale=5.0,
+        n_prompt=NEGATIVE_PROMPT,
+        seed: int | torch.Generator = -1,
+        offload_model=True,
+    ):
+        sample_scheduler, timesteps = self._get_scheduler(
+            sample_solver, sampling_steps, shift
+        )
+
+        if t_i is None:
+            i0 = 0
+        else:
+            mask = timesteps == t_i
+
+            if not mask.any():
+                raise ValueError
+
+            idx = mask.nonzero(as_tuple=True)
+
+            if len(idx[0]) != 1:
+                raise ValueError(f"Expected exactly one match, found {len(idx[0])}")
+
+            i0 = idx[0][0].item()
+
+        if isinstance(seed, int):
+            seed = resolve_diffusion_seed(seed, self.device)
+            seed_g = torch.Generator(device=self.device)
+            seed_g.manual_seed(seed)
+        elif isinstance(seed, torch.Generator):
+            seed_g = seed
+        else:
+            raise ValueError
+
+        bias_kwargs = bias_kwargs.copy()
+        timestep_bias_schedule = bias_kwargs.pop("timestep_bias_schedule")
+        if len(timestep_bias_schedule) != len(timesteps):
+            raise ValueError(
+                "timestep_bias_schedule length must match scheduler timestep count"
+            )
+
+        img_tensor = self._img_to_tensor(img)
+        y, max_seq_len = self._build_latents(img_tensor, frame_num, max_area)
+        context, context_null, clip_context, bias_kwargs = self._build_context(
+            img_tensor,
+            prompt_sentences,
+            n_prompt,
+            bias_kwargs=bias_kwargs,
+            offload_model=offload_model,
+        )
+
+        @contextmanager
+        def noop_no_sync():
+            yield
+
+        no_sync = getattr(self.model, 'no_sync', noop_no_sync)
+        temp_x0 = None
+
+        with (
+            torch.autocast("cuda", dtype=self.param_dtype),
+            torch.no_grad(),
+            no_sync(),
+        ):
+            if offload_model:
+                torch.cuda.empty_cache()
+
+            self.model.to(self.device)  # ty:ignore[invalid-argument-type]
+            simil_masks_list = []
+            generated_simil_masks_list = []
+            # NOTE: timesteps is a decreasing sequence (1.0 -> 0.0)
+            for i, t in enumerate(tqdm(timesteps[i0:])):
+                bias_timestep = timestep_bias_schedule[i + i0]
+
+                timestep = torch.tensor([t], device=self.device)
+                latent = latent.to(self.device)
+
+                norm_t = timestep / self.num_train_timesteps
+                assert (0.0 <= norm_t) and (norm_t <= 1.0)
+                with runtime_observation_scope(step=i + i0):
+                    noise_pred, simil_masks, generated_simil_masks = (
+                        self._compute_noise_pred(
+                            [latent],
+                            timestep,
+                            [y],
+                            context=context,
+                            context_null=context_null,
+                            clip_context=clip_context,
+                            bias_kwargs=bias_kwargs
+                            | {"normalized_timestep": norm_t, "bias": bias_timestep},
+                            max_seq_len=max_seq_len,
+                            guide_scale=guide_scale,
+                            offload_model=offload_model,
+                        )
+                    )
+
+                latent = latent.to(
+                    torch.device('cpu') if offload_model else self.device
+                )
+
+                simil_masks = simil_masks.to("cpu")
+                generated_simil_masks = generated_simil_masks.to("cpu")
+                simil_masks_list.append(simil_masks)
+                generated_simil_masks_list.append(generated_simil_masks)
+
+                temp_x0 = sample_scheduler.step(
+                    noise_pred.unsqueeze(0),
+                    t,
+                    latent.unsqueeze(0),
+                    return_dict=False,
+                    generator=seed_g,
+                )[0]
+                latent = temp_x0.squeeze(0)
+
+            if offload_model:
+                self.model.cpu()
+                torch.cuda.empty_cache()
+
+            emit_runtime_observation("final-latent", output_tensor=latent)
+            videos = [None]
+            if self.rank == 0:
+                videos = self.vae.decode([latent.to(self.device)])
+
+        del latent, temp_x0
+
+        if offload_model:
+            gc.collect()
+            torch.cuda.synchronize()
+
+        if dist.is_initialized():
+            dist.barrier()
+
+        simil_masks = torch.stack(simil_masks_list, dim=1)
+        generated_simil_masks = torch.stack(generated_simil_masks_list, dim=1)
+
+        extra_data = {
+            # Backwards-compatible name: these are exactly the masks consumed by
+            # both self- and cross-attention and shown by existing diagnostics.
+            "simil_masks": simil_masks,
+            "used_simil_masks": simil_masks,
+            "generated_simil_masks": generated_simil_masks,
+            "diffusion_seed": int(seed_g.initial_seed()),
+        }
+        return (videos[0], extra_data) if self.rank == 0 else None
+
+    def generate(
+        self,
+        prompt_sentences: list[str],
+        img: Image.Image,
+        bias_kwargs,
+        max_area=720 * 1280,
+        frame_num=81,
+        shift=5.0,
+        sample_solver='unipc',
+        sampling_steps=40,
+        guide_scale=5.0,
+        n_prompt=NEGATIVE_PROMPT,
+        seed=-1,
+        offload_model=True,
+    ):
+        r"""
+        Generates video frames from input image and text prompt using diffusion process.
+
+        Args:
+            input_prompt (`str`):
+                Text prompt for content generation.
+            img (PIL.Image.Image):
+                Input image tensor. Shape: [3, H, W]
+            max_area (`int`, *optional*, defaults to 720*1280):
+                Maximum pixel area for latent space calculation. Controls video resolution scaling
+            frame_num (`int`, *optional*, defaults to 81):
+                How many frames to sample from a video. The number should be 4n+1
+            shift (`float`, *optional*, defaults to 5.0):
+                Noise schedule shift parameter. Affects temporal dynamics
+                [NOTE]: If you want to generate a 480p video, it is recommended to set the shift value to 3.0.
+            sample_solver (`str`, *optional*, defaults to 'unipc'):
+                Solver used to sample the video.
+            sampling_steps (`int`, *optional*, defaults to 40):
+                Number of diffusion sampling steps. Higher values improve quality but slow generation
+            guide_scale (`float`, *optional*, defaults 5.0):
+                Classifier-free guidance scale. Controls prompt adherence vs. creativity
+            n_prompt (`str`, *optional*, defaults to ""):
+                Negative prompt for content exclusion. If not given, use `config.sample_neg_prompt`
+            seed (`int`, *optional*, defaults to -1):
+                Random seed for noise generation. If -1, use random seed
+            offload_model (`bool`, *optional*, defaults to True):
+                If True, offloads models to CPU during generation to save VRAM
+
+        Returns:
+            torch.Tensor:
+                Generated video frames tensor. Dimensions: (C, N H, W) where:
+                - C: Color channels (3 for RGB)
+                - N: Number of frames (81)
+                - H: Frame height (from max_area)
+                - W: Frame width from max_area)
+        """
+
+        # Resolve and synchronize the integer before any public-path noise is made.
+        w, h = img.size
+        seed, seed_g, noise = initialize_diffusion_noise(
+            seed,
+            self.device,
+            lambda generator: self._generate_noise(
+                (h, w), max_area, frame_num, generator
+            ),
+        )
+        emit_runtime_observation(
+            "initial-latent", seed=seed, latent_tensor=noise
+        )
+
+        return self.generate_from_latents(
+            img,
+            prompt_sentences,
+            bias_kwargs,
+            noise,
+            max_area=max_area,
+            frame_num=frame_num,
+            shift=shift,
+            sample_solver=sample_solver,
+            sampling_steps=sampling_steps,
+            guide_scale=guide_scale,
+            n_prompt=n_prompt,
+            seed=seed_g,
+            offload_model=offload_model,
+        )
diff --git a/wan/utils/attention_contracts.py b/wan/utils/attention_contracts.py
new file mode 100644
index 0000000000000000000000000000000000000000..36b1c899edeace802dd2e658fdf529406717d4cf
--- /dev/null
+++ b/wan/utils/attention_contracts.py
@@ -0,0 +1,127 @@
+"""Small, executable contracts shared by the custom attention paths."""
+
+import torch
+from torch.nn import functional as F
+
+MASK_SHARING_ALIASES = {
+    None: "current",
+    "none": "current",
+    "current": "current",
+    "first": "first",
+    "block0": "first",
+    "prev": "previous_generated",
+    "previous-generated": "previous_generated",
+}
+
+
+def normalize_mask_sharing(value):
+    """Return the canonical generated-mask sharing policy."""
+    try:
+        return MASK_SHARING_ALIASES[value]
+    except (KeyError, TypeError) as exc:
+        raise ValueError(
+            "mask_sharing must be one of none/current, first/block0, or "
+            "prev/previous-generated"
+        ) from exc
+
+
+def select_used_simil_masks(generated, incoming):
+    """Select the one mask tensor that both self- and cross-attention must use."""
+    return generated if incoming is None else incoming
+
+
+def update_shared_simil_masks(policy, block_index, generated, active):
+    """Return the incoming shared mask for the next block."""
+    if policy == "previous_generated" or (policy == "first" and block_index == 0):
+        return generated
+    return active
+
+
+def self_attention_bias_enabled(bias_kwargs):
+    """Apply self-routing only when every schedule/CFG guard enables it."""
+    return (
+        bool(bias_kwargs["bias"])
+        and bias_kwargs["bias_method"] != "none"
+        and bool(bias_kwargs["self_attention_masking"])
+    )
+
+
+def build_static_simil_masks(face_masks, T):
+    """Build a background+subject partition without invoking a tracker."""
+    if face_masks.ndim != 2:
+        raise ValueError("flattened face_masks must have shape [subjects, H*W]")
+    if (face_masks.bool().sum(dim=0) > 1).any():
+        raise ValueError("subject masks must be disjoint")
+    face_masks = face_masks.bool()
+    background_mask = ~face_masks.any(dim=0, keepdim=True)
+    all_masks = torch.cat([background_mask, face_masks], dim=0)
+    return all_masks.unsqueeze(0).repeat(1, 1, T).float()
+
+
+def validate_simil_masks(masks, expected_classes=None):
+    """Require floating, finite class partitions for fixed/hard/soft masks."""
+    if masks.ndim != 3:
+        raise ValueError("similarity masks must have shape [batch, classes, tokens]")
+    if expected_classes is not None and masks.shape[1] != expected_classes:
+        raise ValueError("similarity mask class count does not match subjects+background")
+    masks = masks.float()
+    if not torch.isfinite(masks).all() or (masks < 0).any() or (masks > 1).any():
+        raise ValueError("similarity masks must be finite and lie in [0, 1]")
+    sums = masks.sum(dim=1)
+    if not torch.allclose(sums, torch.ones_like(sums), atol=1e-2):
+        raise ValueError("similarity mask classes must form a partition")
+    return masks
+
+
+def validate_eligibility(eligibility):
+    """Validate continuous regional eligibility weights."""
+    if not eligibility.is_floating_point():
+        eligibility = eligibility.float()
+    if not torch.isfinite(eligibility).all():
+        raise ValueError("attention eligibility must be finite")
+    if (eligibility < 0).any() or (eligibility > 1).any():
+        raise ValueError("attention eligibility must lie in [0, 1]")
+    return eligibility
+
+
+def ediff_attention(
+    q, k, v, eligibility, strength, normalized_timestep, valid_tokens=None
+):
+    """Finite eDiff-I-style positive bias; eligibility is not hard exclusion."""
+    eligibility = validate_eligibility(eligibility).to(device=q.device, dtype=q.dtype)
+    attn_bias = strength * normalized_timestep * eligibility
+    if valid_tokens is not None:
+        valid_tokens = valid_tokens.to(device=q.device, dtype=torch.bool)
+        if valid_tokens.ndim != 1 or valid_tokens.numel() != k.shape[-2]:
+            raise ValueError("valid_tokens must match the text key length")
+        if not valid_tokens.any():
+            raise ValueError("at least one text token must be valid")
+        attn_bias = attn_bias.masked_fill(
+            ~valid_tokens[None, None, :], float("-inf")
+        )
+    return F.scaled_dot_product_attention(q, k, v, attn_mask=attn_bias.unsqueeze(1))
+
+
+def regional_attention(q, k, v, eligibility):
+    """SDPA with log eligibility; exact zero excludes a key for that query.
+
+    Fractional values are a continuous extension of binary regional prompting.
+    Rows with no eligible keys intentionally produce a zero text-attention output.
+    """
+    eligibility = validate_eligibility(eligibility).to(device=q.device, dtype=q.dtype)
+    has_eligible_key = eligibility.gt(0).any(dim=-1)
+    safe_eligibility = eligibility.clone()
+    if not has_eligible_key.all():
+        # Avoid backend-dependent NaNs for an all-masked row, then zero that row.
+        safe_eligibility[..., 0] = torch.where(
+            has_eligible_key,
+            safe_eligibility[..., 0],
+            torch.ones_like(safe_eligibility[..., 0]),
+        )
+    attn_bias = torch.where(
+        safe_eligibility > 0,
+        safe_eligibility.log(),
+        torch.full_like(safe_eligibility, float("-inf")),
+    ).unsqueeze(1)
+    output = F.scaled_dot_product_attention(q, k, v, attn_mask=attn_bias)
+    return output * has_eligible_key[:, None, :, None].to(output.dtype)
