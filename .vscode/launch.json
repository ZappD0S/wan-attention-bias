{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "[HISTORICAL/NONCANONICAL] Python: Multi Sample Inference",
      "type": "debugpy",
      "request": "launch",
      "module": "multi_sample_inference.multi_sample_inference",
      "args": [
        "--prompts-file",
        "${workspaceFolder}/image_prompt_generation/prompts_modified.json",
        "--param-grid-file",
        "${workspaceFolder}/multi_sample_inference/param_configs/only_concept_weaver.json",
        "--output-path",
        "${workspaceFolder}/multi_sample_inference/debug_output/",
        "--checkpoint-path",
        "${workspaceFolder}/weights/",
        "--t5-cpu"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Apptainer: Attach Python",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/workspace"
        }
      ]
    }
  ]
}
