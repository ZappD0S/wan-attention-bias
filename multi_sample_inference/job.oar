#!/bin/bash
#OAR -n multi_sample_inference
#OAR -q abaca
#OAR -p musa
#OAR -l walltime=48:00:00
#OAR -O logs/output_%j.log
#OAR -E logs/error_%j.log
#OAR --checkpoint 60
#OAR -t idempotent

if [ -z "$PARAM_CONFIG_NAME" ]; then
  echo "ERROR: PARAM_CONFIG_NAME environment variable is not set."
  exit 1
fi

# Renamed handler: forwards the timeout signal to Python and lets bash continue
checkpoint_handler() {
  echo "STATUS: Received OAR timeout signal (SIGUSR2). 60 seconds remaining!"

  if [ -n "$PYTHON_PID" ]; then
    kill -USR2 $PYTHON_PID 2>/dev/null
  fi

  # We do NOT exit here. This allows the script to fall back to the wait
  # commands below so Python actually has time to save its files to disk.
}

trap 'checkpoint_handler' SIGUSR2

module purge
module load apptainer

echo "STATUS: Checking GPU availability via nvidia-smi..."
nvidia-smi || {
  echo "ERROR: nvidia-smi failed. Driver not found." >&2
  exit 1
}

# paths and env
PROMPTS_FILE="./image_prompt_generation/prompts_modified.json"
PARAM_GRID_FILE="./multi_sample_inference/param_configs/${PARAM_CONFIG_NAME}.json"

STORAGE="/storage"
OUTPUT_DIR="$STORAGE/attn_bias/output_videos/${PARAM_CONFIG_NAME}"

if [ ! -f "$PARAM_GRID_FILE" ]; then
  echo "ERROR: Parameter file $PARAM_GRID_FILE does not exist." >&2
  exit 1
fi

mkdir -p "$OUTPUT_DIR"

echo "STATUS: Starting Python inference..."

# Run in background so the shell can catch the signal immediately
./run.sh python -m multi_sample_inference.multi_sample_inference \
  --prompts-file "$PROMPTS_FILE" \
  --param-grid-file "$PARAM_GRID_FILE" \
  --output-path "$OUTPUT_DIR" &

PYTHON_PID=$!

# 'wait' will be interrupted if the shell receives SIGUSR2 (returning code 140).
wait $PYTHON_PID
EXIT_CODE=$?

# If interrupted by SIGUSR2, wait AGAIN to give Python time to finish saving its checkpoint
if [ $EXIT_CODE -eq 140 ]; then
  echo "STATUS: Interrupted by SIGUSR2. Waiting for Python to finish checkpointing..."
  wait $PYTHON_PID
  EXIT_CODE=140 # Preserve the 140 code for the resubmit check below
fi

if [ $EXIT_CODE -eq 0 ]; then
  echo "STATUS: Job completed successfully."
  exit 0

elif [ $EXIT_CODE -eq 2 ] || [ $EXIT_CODE -eq 140 ]; then
  echo "STATUS: Work remains or Checkpoint reached. Resubmitting via idempotent feature..."
  # Exit 99 triggers OAR's idempotent feature to automatically clone and resubmit this job
  exit 99

elif [ $EXIT_CODE -eq 143 ] || [ $EXIT_CODE -eq 130 ]; then
  echo "STATUS: Job was manually cancelled or terminated. Exiting gracefully."
  exit 0

else
  echo "STATUS: Python script failed with Exit Code $EXIT_CODE."
  exit $EXIT_CODE
fi
