Bootstrap: docker
From: ghcr.io/astral-sh/uv:latest
Stage: uv_source

Bootstrap: docker
From: nvidia/cuda:12.8.2-devel-ubuntu24.04

%environment
    export LC_ALL=C.UTF-8
    export CUDA_HOME=/usr/local/cuda
    export PATH="/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"

    # uv offline & path settings
    export UV_LINK_MODE=copy
    export UV_OFFLINE=1
    export UV_PYTHON_DOWNLOADS=never
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python

    export VIRTUAL_ENV=/opt/venv
    export PATH="/opt/venv/bin:$PATH"

%files from uv_source
    /uv /usr/local/bin/uv
    /uvx /usr/local/bin/uvx

%files
    pyproject.toml /opt/build/pyproject.toml
    uv.lock /opt/build/uv.lock
    .python-version /opt/build/.python-version

    lama /opt/build/lama
    wan2.1 /opt/build/wan2.1

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git git-lfs curl ca-certificates \
      ffmpeg libglib2.0-0 libgl1

    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export UV_PROJECT_ENVIRONMENT=/opt/venv

    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="7.0;7.5;8.0;8.6;8.9;9.0+PTX"

    cd /opt/build

    uv sync --frozen --no-dev --no-editable

    chmod -R +rX /opt/uv/python
    chmod -R +rX /opt/venv

    cd /
    rm -rf /opt/build
    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    exec bash "$@"
